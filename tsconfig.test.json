{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": false,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "rootDir": "./",
    "types": ["jest"]
  },
  "include": [ "src/**/*", "tests/**/*" ],
  "exclude": [
    "node_modules",
    "demo",
    "dist",
    "types"
  ]
}
